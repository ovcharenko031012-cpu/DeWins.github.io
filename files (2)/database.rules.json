{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.val() === true"
      }
    },
    "drops": {
      ".read": true,
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name','type','rar','nick','ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(pistol|rifle|knife|glove)$/)"
        },
        "rar": {
          ".validate": "newData.isString() && newData.val().matches(/^[cuerl]$/)"
        },
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 24"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
